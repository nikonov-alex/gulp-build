import gulp from "gulp"
import path from 'path'
import civet from "gulp-civet"
import ts from "gulp-typescript"
typescript := ts.createProject( "tsconfig.json" )
import rename from "gulp-rename"
import esbuild from "./lib/gulp-esbuild"
import dartSass from "sass"
import gulpSass from "gulp-sass"
const sass = gulpSass(dartSass)
import merge from "merge-stream"
import babel from "gulp-babel"
import minify from "gulp-terser"
import postcss from "gulp-postcss"
import File from 'vinyl'
import { PluginBuild } from 'esbuild'


Stream ::= NodeJS.ReadWriteStream

map :=
    (plugin: Stream) =>
        (stream: Stream) =>
            stream.pipe(plugin)

id := <A>( value: A ) => value

skip := id



readFile := (stream: Stream) => async (targetPath: string ) =>
    isVinylFile := ( file: unknown ): file is File =>
        !!file && typeof file is 'object' && 'path' in file && 'isBuffer' in file

    absoluteTarget := path.resolve( targetPath )

    contents := for await file of stream
        when isVinylFile(file) && file.path === absoluteTarget && file.isBuffer()
            file.contents.toString('utf8')

    if contents.length > 0 then contents[0] else null

  



type BundlerOptions = Omit<esbuild.Options, "entry">

makeTask := ( { input, output, development, ... options }: {
    input: {
        sources: string
        entry: string
    }
    output: {
        dir: string
        filename: string
    }
    esbuild?: BundlerOptions
    development?: boolean
} ) =>

    relative := ( relative: string ) =>
        path.posix.join( input.sources, relative )

    ext := ( ... extensions: string[] ) =>
        globs := extensions.map( (ext) => relative( `/**/*${ext}` ) )
        gulp.src( globs )

    maybe := ( plugin: Stream ) =>
        if development then skip else map( plugin )


    scripts := do
        civets := ext( ".civet", ".d.ts" )
            |> map( civet( {
                extension: '.tsx'
                js: false
            } ) )
            |> map( typescript() )
            |> map( rename( { extname: ".civet" } ) )


    styles := do
        sasses := ext( ".sass" )
            |> map( sass().on('error', sass.logError) )
            |> map( rename( { extname: ".sass" }  ) )

        scsses := ext( ".scss" )
            |> map( sass().on('error', sass.logError) )
            |> map( rename( { extname: ".scss" } ) )

        merge( sasses, scsses )
            |> maybe( postcss() )

    stylesPlugin := {
        name: 'css-stylesheet'
        setup( build: PluginBuild ) {
            readStyle := readFile( styles )

            build.onLoad({ filter: /\.(css|sass|scss)$/ }, async (args) =>
                styles := await readStyle( args.path )

                if styles is null then
                    {
                        errors: [ {
                            text: "Failed to read CSS file"
                            location: { file: args.path }
                        } ]
                    }
                else do
                    contents := `
                        const stylesheet = new CSSStyleSheet();
                        stylesheet.replaceSync(${JSON.stringify(styles)});
                        export default stylesheet;`

                    { contents, loader: 'js' }
            )
        }
    }

    bundler := esbuild( {
        entry: relative( input.entry )
        bundle: true
        loader: {
            ".civet": "js"
            '.css': 'text'
            '.scss': 'text'
            '.sass': 'text'
        }
        resolveExtensions: [ ".js", ".jsx", ".mjs", ".civet" ]
        plugins: [ stylesPlugin ]
        ... options.esbuild
    } )

    () =>
        merge( scripts, styles )
            |> map( bundler )
            |> maybe( babel() )
            |> maybe( minify() )
            |> map( rename( output.filename ) )
            |> map( gulp.dest( output.dir ) )



export default makeTask